NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/wakilisha
DATABASE_SSL=false
SESSION_DAYS=1
SCHOOL_NAME=Wakilisha Comprehensive School
SCHOOL_EMAIL=admissions@example.org
SCHOOL_PHONE=+254700000000
SCHOOL_ADDRESS=Kenya
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Pesapal API 3.0 - obtain these from your own merchant account
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Required for administrator/headteacher/bursar TOTP secret encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# Private student uploads (Supabase recommended for serverless deployments)
STORAGE_DRIVER=local
STORAGE_DIR=.uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=wakilisha-private
